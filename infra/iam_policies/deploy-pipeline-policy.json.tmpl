{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect":"Allow",
      "Action":[
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource":[
        "arn:aws:s3:::${s3_tf_state_bucket}/state/*"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
        "s3:ListBucket"
      ],
      "Resource":[
        "arn:aws:s3:::${s3_tf_state_bucket}"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:GetFunctionConfiguration",
        "lambda:AddPermission",
        "lambda:GetFunction",
        "lambda:DeleteFunction",
        "lambda:ListVersionsByFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetPolicy",
        "lambda:PublishVersion",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": [
        "arn:aws:lambda:${region}:${account_id}:function:aws_list-accounts-${env}",
        "arn:aws:lambda:${region}:${account_id}:function:aws_verify-takeover-${env}",
        "arn:aws:lambda:${region}:${account_id}:function:azure-lambda-${env}",
        "arn:aws:lambda:${region}:${account_id}:function:aws_list-accounts-${env}:*",
        "arn:aws:lambda:${region}:${account_id}:function:aws_verify-takeover-${env}:*",
        "arn:aws:lambda:${region}:${account_id}:function:azure-lambda-${env}:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:CreateEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "dynamodb:PutItem",
         "dynamodb:GetItem",
         "dynamodb:DeleteItem"
      ],
      "Resource":"arn:aws:dynamodb:${region}:${account_id}:table/terraform-lock"
    },
    {
      "Effect":"Allow",
      "Action":[
         "iam:GetRole",
         "iam:CreateRole",
         "iam:DeleteRole",
         "iam:UpdateRole",
         "iam:UpdateAssumeRolePolicy",
         "iam:ListRoleTags",
         "iam:TagRole",
         "iam:UntagRole",
         "iam:ListRolePolicies",
         "iam:ListAttachedRolePolicies",
         "iam:GetRolePolicy",
         "iam:PutRolePolicy",
         "iam:DeleteRolePolicy",
         "iam:AttachRolePolicy",
         "iam:DetachRolePolicy"
      ],
      "Resource":[
        "arn:aws:iam::${account_id}:role/SubdomainTakeoverHealthCheckRole-${env}",
        "arn:aws:iam::${account_id}:role/SubdomainTakeoverDeployPipelineRole-${env}",
        "arn:aws:iam::${account_id}:role/aws_list-accounts-${env}",
        "arn:aws:iam::${account_id}:role/aws_verify-takeover-${env}",
        "arn:aws:iam::${account_id}:role/azure-lambda-${env}"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "iam:PassRole"
      ],
      "Resource":[
        "arn:aws:iam::${account_id}:role/aws_list-accounts-${env}",
        "arn:aws:iam::${account_id}:role/aws_verify-takeover-${env}",
        "arn:aws:iam::${account_id}:role/azure-lambda-${env}"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "iam:GetPolicy",
         "iam:CreatePolicy",
         "iam:DeletePolicy",
         "iam:GetPolicyVersion",
         "iam:ListPolicyVersions",
         "iam:CreatePolicyVersion",
         "iam:DeletePolicyVersion",
         "iam:ListPolicyTags",
         "iam:TagPolicy",
         "iam:UntagPolicy"
      ],
      "Resource":[
        "arn:aws:iam::${account_id}:policy/SubdomainHealtCheckPolicy-${env}",
        "arn:aws:iam::${account_id}:policy/SubdomainDeployPipelinePolicy-${env}",
        "arn:aws:iam::${account_id}:policy/UnhappyCheckPolicy-${env}",
        "arn:aws:iam::${account_id}:policy/cross-account-role-policy-${env}",
        "arn:aws:iam::${account_id}:policy/ProdSecCrossAccountPolicy-${env}",
        "arn:aws:iam::${account_id}:policy/sqs-write-policy-${env}",
        "arn:aws:iam::${account_id}:policy/aws_list-accounts-${env}-logs",
        "arn:aws:iam::${account_id}:policy/aws_verify-takeover-${env}-logs",
        "arn:aws:iam::${account_id}:policy/azure-lambda-${env}-logs"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "iam:GetOpenIDConnectProvider",
         "iam:CreateOpenIDConnectProvider",
         "iam:DeleteOpenIDConnectProvider",
         "iam:UpdateOpenIDConnectProviderThumbprint",
         "iam:AddClientIDToOpenIDConnectProvider",
         "iam:RemoveClientIDFromOpenIDConnectProvider",
         "iam:ListOpenIDConnectProviderTags",
         "iam:TagOpenIDConnectProvider",
         "iam:UntagOpenIDConnectProvider"
      ],
      "Resource":[
        "arn:aws:iam::${account_id}:oidc-provider/token.actions.githubusercontent.com"
      ]
    },
   {
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:${region}:${account_id}:parameter/*"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "events:DescribeRule",
         "events:PutRule",
         "events:DeleteRule",
         "events:EnableRule",
         "events:DisableRule",
         "events:PutTargets",
         "events:RemoveTargets",
         "events:ListTagsForResource",
         "events:ListTargetsByRule",
         "events:TagResource",
         "events:UntagResource"
      ],
      "Resource":[
        "arn:aws:events:${region}:${account_id}:rule/Monday-schedule-${env}",
        "arn:aws:events:${region}:${account_id}:rule/Monday-schedule-aws-lists-accounts-${env}"
      ]
    },
        {
      "Effect":"Allow",
      "Action":[
         "logs:CreateLogGroup",
         "logs:DeleteLogGroup",
         "logs:PutRetentionPolicy",
         "logs:DeleteRetentionPolicy",
         "logs:ListTagsForResource",
         "logs:TagResource",
         "logs:UntagResource",
         "logs:TagLogGroup",
         "logs:UntagLogGroup"
      ],
      "Resource":[
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/aws_list-lambda-${env}",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/aws_list-lambda-${env}:*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/aws_verify-takeover-${env}",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/aws_verify-takeover-${env}:*",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/azure-lambda-${env}",
        "arn:aws:logs:${region}:${account_id}:log-group:/aws/lambda/azure-lambda-${env}:*"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "sqs:GetQueueAttributes",
         "sqs:SetQueueAttributes",
         "sqs:CreateQueue",
         "sqs:DeleteQueue",
         "sqs:GetQueueUrl",
         "sqs:ListQueueTags",
         "sqs:TagQueue",
         "sqs:UntagQueue"
      ],
      "Resource":[
        "arn:aws:sqs:${region}:${account_id}:account-ids-${env}-deadletter-queue",
        "arn:aws:sqs:${region}:${account_id}:account-ids-${env}"
      ]
    },
    {
      "Effect":"Allow",
      "Action":[
         "logs:DescribeLogGroups"
      ],
      "Resource":[
        "arn:aws:logs:${region}:${account_id}:log-group:*"
      ]
    }
  ]
}